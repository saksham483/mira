<?xml version="1.0"?>
<root BTCPP_format="4">
    <BehaviorTree ID="SAUVC_Mission">
        <Sequence name="MAIN_MISSION">
            
            <!-- Phase 1: Dive to 0.6m in STABILIZE mode -->
            <DiveToDepth target_depth="0.6" tolerance="0.05"/>

            <!-- Phase 2: Gate Navigation with Fallback -->
            <Fallback name="GATE_TASK_WITH_RETRY">
                
                <!-- Attempt 1: Nominal Gate Approach -->
                <Sequence name="ATTEMPT_1">
                    <Search target="gate" timeout="20.0"/>
                    <TrackAndApproach target="gate" avoid="orange_flare" mode="front_cam" success_area="0.6" lost_timeout="3.0"/>
                    <BlindMove duration="4.0" fwd="1650" lat="1500" thr="1500" yaw="1500"/>
                </Sequence>

                <!-- Attempt 2: Fallback (If it times out or loses the gate) -->
                <Sequence name="RECOVERY_ATTEMPT">
                    <BlindMove duration="2.0" fwd="1350" lat="1500" thr="1500" yaw="1500"/>
                    <Search target="gate" timeout="30.0"/>
                    <TrackAndApproach target="gate" avoid="orange_flare" mode="front_cam" success_area="0.6" lost_timeout="3.0"/>
                    <BlindMove duration="4.0" fwd="1650" lat="1500" thr="1500" yaw="1500"/>
                </Sequence>
            </Fallback>
            
            <EmergencySurface/>
            
        </Sequence>
    </BehaviorTree>
</root>